{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AFTBotDb": "Server=YOUR_SERVER;Database=AFTBotDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "AI": {
    "Provider": "AzureOpenAI",
    "Endpoint": "https://YOUR_RESOURCE.openai.azure.com/",
    "DeploymentName": "gpt-4o-mini",
    "ApiKey": "YOUR_AZURE_OPENAI_API_KEY"
  },
  "LeadScoring": {
    "MobileProvidedPoints": 20,
    "EmailProvidedPoints": 10,
    "ClearRequirementPoints": 20,
    "SpecificProductSelectedPoints": 15,
    "TimelineProvidedPoints": 15,
    "ContactRequestedPoints": 20,
    "LowThresholdMax": 39,
    "MediumThresholdMax": 69
  }
}
